        "accent": { "$value": "{foundation.color.brand-skeleton.500}", "$type": "color", "$description": "Calibrated single accent per design-taste-frontend" },
        "destructive": { "$value": "{foundation.color.status.red.600}", "$type": "color" },
        "destructive-hover": { "$value": "{foundation.color.status.red.700}", "$type": "color" },
        "destructive-text": { "$value": "{foundation.color.neutral.0}", "$type": "color" },
        "destructive-dark": { "$value": "{foundation.color.status.red.500}", "$type": "color" },
        "destructive-hover-dark": { "$value": "{foundation.color.status.red.600}", "$type": "color" },
        "destructive-text-dark": { "$value": "{foundation.color.neutral.0}", "$type": "color" }
      },
      "status": {
        "destructive": { "$value": "{foundation.color.status.red.600}", "$type": "color" },
        "destructive-dark": { "$value": "{foundation.color.status.red.500}", "$type": "color" },
        "destructive-foreground": { "$value": "{foundation.color.neutral.0}", "$type": "color" },
