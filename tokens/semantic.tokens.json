        "warning-foreground": { "$value": "{foundation.color.neutral.0}", "$type": "color" },
        "warning-foreground-dark": { "$value": "{foundation.color.neutral.950}", "$type": "color" },
        "success": { "$value": "{foundation.color.status.green.600}", "$type": "color" },
        "success-dark": { "$value": "{foundation.color.status.green.500}", "$type": "color" },
        "success-foreground": { "$value": "{foundation.color.neutral.0}", "$type": "color" },
