{
  "$schema": "https://designtokens.org/tr/drafts/format/",
  "semantic": {
    "color": {
      "surface": {
        "canvas": { "$value": "{foundation.color.neutral.0}", "$type": "color", "$description": "Base background for light mode" },
        "canvas-dark": { "$value": "{foundation.color.neutral.950}", "$type": "color", "$description": "Base background for dark mode" },
        "sunken": { "$value": "{foundation.color.neutral.50}", "$type": "color", "$description": "Recessed areas (code blocks, sunken inputs)" },
        "sunken-dark": { "$value": "{foundation.color.neutral.1000}", "$type": "color" },
        "subtle": { "$value": "{foundation.color.neutral.100}", "$type": "color" },
        "subtle-dark": { "$value": "{foundation.color.neutral.900}", "$type": "color" },
        "raised": { "$value": "{foundation.color.neutral.0}", "$type": "color" },
        "raised-dark": { "$value": "{foundation.color.neutral.900}", "$type": "color" },
        "overlay": { "$value": "{foundation.color.neutral.0}", "$type": "color", "$description": "Floating panels, popovers, modals" },
        "overlay-dark": { "$value": "{foundation.color.neutral.800}", "$type": "color" }
      },
      "text": {
        "primary": { "$value": "{foundation.color.neutral.950}", "$type": "color", "$description": "High contrast text" },
        "primary-dark": { "$value": "{foundation.color.neutral.50}", "$type": "color" },
        "secondary": { "$value": "{foundation.color.neutral.600}", "$type": "color", "$description": "Readable secondary text (WCAG AA)" },
        "secondary-dark": { "$value": "{foundation.color.neutral.400}", "$type": "color" },
        "muted": { "$value": "{foundation.color.neutral.400}", "$type": "color" },
        "muted-dark": { "$value": "{foundation.color.neutral.500}", "$type": "color" },
        "inverse": { "$value": "{foundation.color.neutral.0}", "$type": "color" },
