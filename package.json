{
  "name": "design-system-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run generate:styles && cd packages/ui && bun run build && cd ../content-ui && bun run build",
    "generate:styles": "bun run scripts/generate-styles.ts",
    "tokens:export": "bun run scripts/css-to-dtcg.ts",
    "tokens:import": "bun run scripts/dtcg-to-css.ts",
    "typecheck": "tsc -p packages/ui --noEmit && tsc -p packages/content-ui --noEmit",
    "storybook": "bun --filter @design-system/storybook dev",
    "storybook:build": "bun --filter @design-system/storybook build",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "lint:design": "design.md lint DESIGN.md",
    "clean": "git clean -xdf dist node_modules .turbo styles/utilities.css dtcg"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0",
    "@playwright/test": "^1.50.0",
    "typescript": "^5.8.2",
    "@tailwindcss/cli": "^4.2.1",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0"
  }
}
