{
  "name": "design-system-template",
  "version": "1.0.0",
  "description": "Autonomous, token-first design system starter template based on Tailwind CSS v4 and React 19.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.5",
  "exports": {
    ".": "./src/main.tsx",
    "./styles.css": "./src/index.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "check:tokens": "node scripts/check-token-gates.mjs",
    "check:brand": "node scripts/check-app-brand-assets.mjs && node scripts/app-brand-validation.test.mjs",
    "check": "bun run check:tokens && bun run check:brand",
    "storybook": "storybook dev -p 6006 -c storybook/.storybook",
    "build-storybook": "storybook build -c storybook/.storybook -o storybook-static",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist storybook-static tsconfig.tsbuildinfo",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.6",
    "jsdom": "^30.1.2",
    "storybook": "10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.3"
  }
}
