        "info": { "$value": "{foundation.color.status.blue.600}", "$type": "color" },
        "info-dark": { "$value": "{foundation.color.status.blue.500}", "$type": "color" },
        "info-foreground": { "$value": "{foundation.color.neutral.0}", "$type": "color" },
        "info-foreground-dark": { "$value": "{foundation.color.neutral.0}", "$type": "color" }
      }
    }
  }
}
