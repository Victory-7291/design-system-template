      },
      "border": {
        "default": { "$value": "{foundation.color.neutral.200}", "$type": "color" },
        "default-dark": { "$value": "{foundation.color.neutral.800}", "$type": "color" },
        "subtle": { "$value": "{foundation.color.neutral.100}", "$type": "color" },
        "subtle-dark": { "$value": "{foundation.color.neutral.900}", "$type": "color" },
        "strong": { "$value": "{foundation.color.neutral.300}", "$type": "color" },
        "strong-dark": { "$value": "{foundation.color.neutral.700}", "$type": "color" }
      },
      "action": {
        "primary": { "$value": "{foundation.color.neutral.950}", "$type": "color" },
